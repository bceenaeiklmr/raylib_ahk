    ; Compares the accessors above with sizeof()/offsetof() compiled into the shim.
    ; Rows rather than an object literal: in AutoHotkey 2.0.26 a plain object is
    ; only enumerable through OwnProps(), while arrays enumerate directly.
    static VerifyLayout() {
        static Wants := [
            ["AudioStream", 32, 0, 8, 16, 20, 24],
            ["BoundingBox", 24, 0, 4, 8, 12, 16, 20],
            ["Camera2D", 24, 0, 4, 8, 12, 16, 20],
            ["Camera3D", 44, 0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40],
            ["Font", 48, 0, 4, 8, 32, 40],
            ["GlyphInfo", 40, 0, 4, 8, 12, 16, 24, 28, 32, 36],
            ["Image", 24, 0, 8, 12, 16, 20],
            ["Material", 40, 0, 8, 16, 24],
            ["Matrix", 64, 0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44, 48, 52, 56, 60],
            ["Mesh", 120, 0, 4, 8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96, 104, 108, 112],
            ["Model", 120, 0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44, 48, 52, 56, 60, 64, 68, 72, 80, 88, 96, 104, 112],
            ["ModelAnimation", 56, 0, 4, 8, 16, 24],
            ["Music", 56, 0, 8, 16, 20, 24, 32, 36, 40, 48],
            ["NPatchInfo", 36, 0, 4, 8, 12, 16, 20, 24, 28, 32],
            ["Ray", 24, 0, 4, 8, 12, 16, 20],
            ["RayCollision", 32, 0, 4, 8, 12, 16, 20, 24, 28],
            ["Rectangle", 16, 0, 4, 8, 12],
            ["RenderTexture", 44, 0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40],
            ["Shader", 16, 0, 8],
            ["Sound", 40, 0, 8, 16, 20, 24, 32],
            ["Texture", 20, 0, 4, 8, 12, 16],
            ["Vector2", 8, 0, 4],
            ["Vector3", 12, 0, 4, 8],
            ["Vector4", 16, 0, 4, 8, 12],
            ["Wave", 24, 0, 4, 8, 12, 16]
        ]
        for rlRow in Wants {
            rlBuf := Buffer(4 * (rlRow.Length - 1), 0)
            DllCall("raylib_ahk_shim\rla_layout_" rlRow[1], "Ptr", rlBuf)
            Loop rlRow.Length - 1
                if (NumGet(rlBuf, 4 * (A_Index - 1), "UInt") != rlRow[A_Index + 1])
                    throw Error("raylib.ahk: " rlRow[1] " layout no longer matches")
        }
    }

