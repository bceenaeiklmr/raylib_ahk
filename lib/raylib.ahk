        DllCall("raylib.dll\SetConfigFlags", "UInt", rlFlags)
    }

    ; ---------------------------------------------------------------- drawing modes
    ; Setup canvas (framebuffer) to start drawing
    static BeginDrawing() {
        DllCall("raylib.dll\BeginDrawing")
    }
    ; End canvas drawing and swap buffers (double buffering)
    static EndDrawing() {
        DllCall("raylib.dll\EndDrawing")
    }
    ; Ends 2D mode with custom camera
    static EndMode2D() {
        DllCall("raylib.dll\EndMode2D")
    }
    ; Ends 3D mode and returns to default 2D orthographic mode
    static EndMode3D() {
        DllCall("raylib.dll\EndMode3D")
    }
    ; Ends drawing to render texture
    static EndTextureMode() {
        DllCall("raylib.dll\EndTextureMode")
    }
    ; End custom shader drawing (use default shader)
    static EndShaderMode() {
        DllCall("raylib.dll\EndShaderMode")
    }
    ; Begin blending mode (alpha, additive, multiplied, subtract, custom)
    static BeginBlendMode(rlMode) {
        DllCall("raylib.dll\BeginBlendMode", "Int", rlMode)
    }
    ; End blending mode (reset to default: alpha blending)
    static EndBlendMode() {
        DllCall("raylib.dll\EndBlendMode")
    }
    ; Begin scissor mode (define screen area for following drawing)
    static BeginScissorMode(rlX, rlY, rlWidth, rlHeight) {
        DllCall("raylib.dll\BeginScissorMode", "Int", rlX, "Int", rlY, "Int", rlWidth, "Int", rlHeight)
    }
    ; End scissor mode
    static EndScissorMode() {
        DllCall("raylib.dll\EndScissorMode")
    }
    ; End stereo rendering (requires VR simulator)
    static EndVrStereoMode() {
        DllCall("raylib.dll\EndVrStereoMode")
    }

    ; ---------------------------------------------------------------- time, control & misc
    ; Set target FPS (maximum)
    static SetTargetFPS(rlFps) {
        DllCall("raylib.dll\SetTargetFPS", "Int", rlFps)
    }
    ; Get time in seconds for last frame drawn (delta time)
    static GetFrameTime() {
        return DllCall("raylib.dll\GetFrameTime", "Float")
    }
    ; Get elapsed time in seconds since InitWindow()
    static GetTime() {
        return DllCall("raylib.dll\GetTime", "Double")
    }
    ; Get current FPS
    static GetFPS() {
        return DllCall("raylib.dll\GetFPS", "Int")
    }
    ; Swap back buffer with front buffer (screen drawing)
    static SwapScreenBuffer() {
        DllCall("raylib.dll\SwapScreenBuffer")
    }
    ; Register all input events
    static PollInputEvents() {
        DllCall("raylib.dll\PollInputEvents")
    }
    ; Wait for some time (halt program execution)
    static WaitTime(rlSeconds) {
        DllCall("raylib.dll\WaitTime", "Double", rlSeconds)
    }
    ; Set the seed for the random number generator
    static SetRandomSeed(rlSeed) {
        DllCall("raylib.dll\SetRandomSeed", "UInt", rlSeed)
    }
    ; Get a random value between min and max (both included)
    static GetRandomValue(rlMin, rlMax) {
        return DllCall("raylib.dll\GetRandomValue", "Int", rlMin, "Int", rlMax, "Int")
    }
    ; Takes a screenshot of current screen (filename extension defines format)
    static TakeScreenshot(rlFileName) {
        DllCall("raylib.dll\TakeScreenshot", "Ptr", RL.U8(rlFileName))
    }
    ; Open URL with default system browser (if available)
    static OpenURL(rlUrl) {
        DllCall("raylib.dll\OpenURL", "Ptr", RL.U8(rlUrl))
    }
    ; Set the current threshold (minimum) log level
    static SetTraceLogLevel(rlLogLevel) {
        DllCall("raylib.dll\SetTraceLogLevel", "Int", rlLogLevel)
    }

    ; ---------------------------------------------------------------- files & paths
    ; Check if file exists
    static FileExists(rlFileName) {
        return DllCall("raylib.dll\FileExists", "Ptr", RL.U8(rlFileName), "Char")
    }
    ; Check if a directory path exists
    static DirectoryExists(rlDirPath) {
        return DllCall("raylib.dll\DirectoryExists", "Ptr", RL.U8(rlDirPath), "Char")
    }
    ; Check file extension (including point: .png, .wav)
    static IsFileExtension(rlFileName, rlExt) {
        return DllCall("raylib.dll\IsFileExtension", "Ptr", RL.U8(rlFileName), "Ptr", RL.U8(rlExt), "Char")
    }
    ; Get file length in bytes (NOTE: GetFileSize() conflicts with windows.h)
    static GetFileLength(rlFileName) {
        return DllCall("raylib.dll\GetFileLength", "Ptr", RL.U8(rlFileName), "Int")
    }
    ; Get pointer to extension for a filename string (includes dot: '.png')
    static GetFileExtension(rlFileName) {
        rlBuf0 := RL.U8(rlFileName)
        return RL.S8(DllCall("raylib.dll\GetFileExtension", "Ptr", rlBuf0, "Ptr"))
    }
    ; Get pointer to filename for a path string
    static GetFileName(rlFilePath) {
        rlBuf0 := RL.U8(rlFilePath)
        return RL.S8(DllCall("raylib.dll\GetFileName", "Ptr", rlBuf0, "Ptr"))
    }
    ; Get filename string without extension (uses static string)
    static GetFileNameWithoutExt(rlFilePath) {
        rlBuf0 := RL.U8(rlFilePath)
        return RL.S8(DllCall("raylib.dll\GetFileNameWithoutExt", "Ptr", rlBuf0, "Ptr"))
    }
    ; Get full path for a given fileName with path (uses static string)
    static GetDirectoryPath(rlFilePath) {
        rlBuf0 := RL.U8(rlFilePath)
        return RL.S8(DllCall("raylib.dll\GetDirectoryPath", "Ptr", rlBuf0, "Ptr"))
    }
    ; Get previous directory path for a given path (uses static string)
    static GetPrevDirectoryPath(rlDirPath) {
        rlBuf0 := RL.U8(rlDirPath)
        return RL.S8(DllCall("raylib.dll\GetPrevDirectoryPath", "Ptr", rlBuf0, "Ptr"))
    }
    ; Get current working directory (uses static string)
    static GetWorkingDirectory() {
        return RL.S8(DllCall("raylib.dll\GetWorkingDirectory", "Ptr"))
    }
    ; Get the directory of the running application (uses static string)
    static GetApplicationDirectory() {
        return RL.S8(DllCall("raylib.dll\GetApplicationDirectory", "Ptr"))
    }
    ; Create directories (including full path requested), returns 0 on success
    static MakeDirectory(rlDirPath) {
        return DllCall("raylib.dll\MakeDirectory", "Ptr", RL.U8(rlDirPath), "Int")
    }
    ; Change working directory, return true on success
    static ChangeDirectory(rlDir) {
        return DllCall("raylib.dll\ChangeDirectory", "Ptr", RL.U8(rlDir), "Char")
    }
    ; Check if a given path is a file or a directory
    static IsPathFile(rlPath) {
        return DllCall("raylib.dll\IsPathFile", "Ptr", RL.U8(rlPath), "Char")
    }
    ; Check if fileName is valid for the platform/OS
    static IsFileNameValid(rlFileName) {
        return DllCall("raylib.dll\IsFileNameValid", "Ptr", RL.U8(rlFileName), "Char")
    }
    ; Check if a file has been dropped into window
    static IsFileDropped() {
        return DllCall("raylib.dll\IsFileDropped", "Char")
    }

